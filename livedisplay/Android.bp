cc_binary {
    name: "vendor.lineage.livedisplay-service.lenovo_msmnile",
    init_rc: ["vendor.lineage.livedisplay-service.lenovo_msmnile.rc"],
    vintf_fragments: ["vendor.lineage.livedisplay-service.lenovo_msmnile.xml"],
    relative_install_path: "hw",
    srcs: [
        ":vendor.lineage.livedisplay-sdm-pa",
        ":vendor.lineage.livedisplay-sdm-utils",
        "AntiFlicker.cpp",
        "SunlightEnhancement.cpp",
        "service.cpp",
    ],
    vendor: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libbinder",
        "libutils",
        "vendor.lineage.livedisplay-V1-ndk",
    ],
    header_libs: [
        "vendor.lineage.livedisplay-sdm-headers",
    ],
}
